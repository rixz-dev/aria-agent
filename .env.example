# ==========================================================================
# ARIA — contoh konfigurasi. Salin ke .env lalu isi.
# ==========================================================================

NODE_ENV=development

# Token internal untuk komunikasi antar-service di VPS
# (telegram-bot <-> orchestrator, orchestrator <-> whatsapp-bot, dst).
# WAJIB diganti di produksi (NODE_ENV=production akan menolak default).
ARIA_INTERNAL_TOKEN=ganti-dengan-token-acak-panjang

# --------------------------------------------------------------------------
# Database (PostgreSQL). DIKOMENTARI SENGAJA: kosong = mode in-memory (dev).
# Aktifkan setelah Postgres terinstal (native: apt install postgresql,
# atau Docker: npm run db:up).
#DATABASE_URL=postgres://aria:aria@localhost:5432/aria

# Host bind untuk semua HTTP internal. Default 127.0.0.1 = TIDAK terekspos
# ke internet (semua service di VPS yang sama). Ganti ke IP Tailscale/private
# hanya kalau service dipisah ke mesin lain.
ARIA_BIND_HOST=127.0.0.1

# --------------------------------------------------------------------------
# Orchestrator (http)
ORCHESTRATOR_PORT=4100
ORCHESTRATOR_PUBLIC_URL=http://localhost:4100

# Provider AI resmi (kosongkan key untuk menonaktifkan provider tsb)
PROVIDERS_ENABLED=nvidia,gemini,openrouter,opencode

# build.nvidia.com (NIM) — OpenAI-compatible
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini — OpenAI-compatible endpoint resmi
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — OpenAI-compatible aggregator
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Opsional, atribusi di dashboard OpenRouter:
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ARIA

# OpenCode — CLI-based coding agent backend (butuh binary `opencode` terinstall)
OPENCODE_BIN=opencode
OPENCODE_TIMEOUT_MS=120000

# Routing per-task: daftar provider berurutan = prioritas + fallback
ROUTE_INTENT=gemini,nvidia,openrouter
ROUTE_PLANNING=nvidia,openrouter,gemini
ROUTE_CHAT=openrouter,nvidia,gemini
ROUTE_SUMMARIZE=gemini,openrouter,nvidia
ROUTE_CODING=opencode,openrouter,nvidia

# Timeouts provider (ms). Provider yang MENGGANTUNG tidak boleh menguras
# budget request: intent harus cepat; budget = total maksimal seluruh fallback.
PROVIDER_TIMEOUT_MS=45000
PROVIDER_INTENT_TIMEOUT_MS=20000
PROVIDER_ROUTE_BUDGET_MS=80000

# --------------------------------------------------------------------------
# Bot Telegram (antarmuka tunggal: command masuk + approval keluar)
TELEGRAM_BOT_TOKEN=
# ID numeric Telegram user yang boleh mengendalikan ARIA (pisahkan koma).
# Dapatkan via @userinfobot.
TELEGRAM_OWNER_IDS=
# URL endpoint notify yang diekspose app telegram-bot (untuk push approval dan hasil)
TELEGRAM_NOTIFY_PORT=4200
TELEGRAM_NOTIFY_URL=http://localhost:4200

# --------------------------------------------------------------------------
# Bot WhatsApp service (Baileys)
WA_SERVICE_PORT=4300
WA_SERVICE_URL=http://localhost:4300
WA_AUTH_DIR=./data/wa-auth

# --------------------------------------------------------------------------
# Approval gate
APPROVAL_TTL_MS=300000

# Plugin dir (default: ./plugins)
PLUGINS_DIR=./plugins

# Logging: pretty | json
LOG_FORMAT=pretty
LOG_LEVEL=info
